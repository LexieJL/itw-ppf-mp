.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 50;
  background: rgba(139, 0, 51, .16); display: flex; align-items: center; justify-content: center; }
.dialog { width: 560rpx; background: #fff; border-radius: 32rpx; padding: 56rpx 40rpx 40rpx; text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.18); }
.icon { font-size: 56rpx; margin-bottom: 16rpx; }
.text { font-size: 32rpx; line-height: 1.6; color: #222; }
.link { color: #3a6fd8; text-decoration: underline; margin: 0 4rpx; }
.btn { margin-top: 40rpx; background: #8A1538; color: #fff; border-radius: 999rpx; height: 80rpx; line-height: 80rpx; font-size: 28rpx; }
.later { margin-top: 20rpx; color: #999; font-size: 26rpx; }
