.bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; background: #fff; display: flex; align-items: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05); }
.act { display: flex; flex-direction: column; align-items: center; width: 96rpx; margin-right: 16rpx; }
.share { padding: 0; margin: 0 16rpx 0 0; border: none !important; background: none; line-height: 1.2; }
.ico { font-size: 40rpx; line-height: 1.1; color: #333; }
.ico.on { color: #8A1538; }
.lbl { font-size: 20rpx; color: #666; }
.consult { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; background: #8A1538; color: #fff; border-radius: 999rpx; font-size: 28rpx; }
