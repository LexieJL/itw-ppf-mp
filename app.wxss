page {
  --brand: #8A1538;
  --brand-soft: #f6e8ed;
  background: #f6f6f7;
  color: #1f1f1f;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}
.container { padding: 24rpx 32rpx 240rpx; }
.breadcrumb { font-size: 24rpx; color: #888; padding: 20rpx 32rpx 4rpx; }
.card { background: #fff; border-radius: 20rpx; overflow: hidden; margin-bottom: 24rpx; }
.card-pad { padding: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin: 36rpx 0 18rpx; }
.muted { color: #888; font-size: 24rpx; }
/* 图片/视频占位：正式内容由后台上传后替换为 image / video */
.ph {
  background: linear-gradient(135deg, #efe7ea, #dccfd4);
  color: #7a5a66; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center;
}
.ph-play { width: 88rpx; height: 88rpx; border-radius: 50%; background: rgba(0,0,0,.45); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-bottom: 12rpx; }
.btn-primary {
  background: var(--brand); color: #fff; border-radius: 999rpx; font-size: 30rpx;
  height: 88rpx; line-height: 88rpx; text-align: center; margin: 40rpx 0 0;
}
.btn-primary::after { border: none; }
.grid2 { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid2 > .cell { width: calc(50% - 10rpx); margin-bottom: 20rpx; }
.search-box {
  display: flex; align-items: center; background: #fff; border: 2rpx solid #e2e2e2;
  border-radius: 999rpx; height: 72rpx; padding: 0 28rpx; margin: 20rpx 32rpx;
}
.search-box input { flex: 1; font-size: 26rpx; margin-left: 12rpx; }
.tag { display: inline-block; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx; background: var(--brand-soft); color: var(--brand); }
.blurred { filter: blur(12rpx); pointer-events: none; user-select: none; }
.form { background: #fff; border-radius: 20rpx; padding: 8rpx 28rpx; }
.form-row { display: flex; align-items: center; min-height: 96rpx; border-bottom: 1rpx solid #f0f0f0; }
.form-row:last-child { border-bottom: none; }
.form-label { width: 200rpx; flex-shrink: 0; font-size: 28rpx; color: #333; }
.form-label .req { color: var(--brand); margin-left: 4rpx; }
.form-row input, .form-row picker { flex: 1; font-size: 28rpx; }
.form-row textarea { flex: 1; height: 160rpx; font-size: 28rpx; padding: 20rpx 0; }
.picker-val { color: #333; }
.picker-ph { color: #aaa; }
.code-btn { font-size: 24rpx; color: var(--brand); border: 2rpx solid var(--brand); border-radius: 999rpx; padding: 6rpx 20rpx; }
.check-row { display: flex; align-items: center; font-size: 24rpx; color: #666; margin-top: 20rpx; }
.check-row checkbox { transform: scale(.7); }
.link { color: #3a6fd8; }
.empty { padding: 160rpx 0; text-align: center; color: #aaa; }
.empty-icon { font-size: 96rpx; margin-bottom: 16rpx; }
