<view class="{{lock ? 'blurred' : ''}}">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'on' : ''}}" bindtap="pickTab" data-key="{{item.key}}">{{item.name}}</view>
  </view>
  <view class="search-box">
    <text>⌕</text><input placeholder="搜索收藏" value="{{keyword}}" bindinput="onInput" />
  </view>
  <view class="list">
    <view wx:for="{{items}}" wx:key="id" class="card item" bindtap="open" data-url="{{item.url}}">
      <view class="ph thumb">{{typeName[item.type]}}</view>
      <view class="info">
        <view class="t">{{item.title}}</view>
        <view class="muted">{{item.sub}}</view>
      </view>
    </view>
    <view wx:if="{{!items.length}}" class="empty">
      <view class="empty-icon">🗂</view>
      <view>暂无收藏</view>
      <view class="muted">在应用、产品、视频和文档页点击“收藏”即可保存到这里</view>
    </view>
  </view>
</view>
<lock-mask lock="{{lock}}" />
<float-bar />
