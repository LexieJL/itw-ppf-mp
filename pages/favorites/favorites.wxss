.tabs { display: flex; background: #fff; }
.tab { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 28rpx; color: #444; position: relative; }
.tab.on { color: #222; font-weight: 600; }
.tab.on::after { content: ''; position: absolute; left: 32%; right: 32%; bottom: 6rpx; height: 6rpx; border-radius: 6rpx; background: #8B0033; }
.list { padding: 0 32rpx 240rpx; }
.item { display: flex; align-items: center; padding: 20rpx; }
.thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; font-size: 22rpx; flex-shrink: 0; }
.info { flex: 1; min-width: 0; margin-left: 24rpx; }
.t { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
