.avatar { width: 160rpx; height: 160rpx; border-radius: 50%; border: 4rpx dashed #e6d9de; margin: 24rpx auto 40rpx; text-align: center; line-height: 160rpx; font-size: 64rpx; color: #999; }
.roles { display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.role { flex: 1; margin: 0 8rpx; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 999rpx; background: #e4e4e4; font-size: 28rpx; }
.role.on { background: #8B0033; color: #fff; }
.tip { font-size: 24rpx; color: #7a5a00; background: #fff4d6; padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 24rpx; line-height: 1.6; }
.chips { flex: 1; display: flex; flex-wrap: wrap; padding: 16rpx 0 4rpx; }
.chip { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; border: 2rpx solid #ddd; margin: 0 12rpx 12rpx 0; color: #555; }
.chip.on { border-color: #8B0033; color: #8B0033; background: #f6e8ed; }
.radios { flex: 1; display: flex; }
.radio { margin-right: 40rpx; font-size: 28rpx; }
.radio radio { transform: scale(.8); }
.foot { text-align: center; margin-top: 24rpx; }
