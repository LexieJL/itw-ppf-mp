.cats { white-space: nowrap; padding: 0 24rpx; }
.cat { display: inline-block; padding: 10rpx 28rpx; margin: 0 8rpx 8rpx; border-radius: 999rpx; background: #fff; font-size: 26rpx; color: #555; }
.cat.on { background: #8B0033; color: #fff; }
.qa { padding: 24rpx 28rpx; }
.q { display: flex; align-items: flex-start; }
.q-mark, .a-mark { width: 40rpx; height: 40rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 700; text-align: center; line-height: 40rpx; margin-right: 16rpx; flex-shrink: 0; }
.q-mark { background: #8B0033; color: #fff; }
.a-mark { background: #f6e8ed; color: #8B0033; }
.q-t { flex: 1; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.arrow { font-size: 32rpx; color: #999; margin-left: 12rpx; }
.a { display: flex; margin-top: 16rpx; font-size: 26rpx; color: #555; line-height: 1.7; }
.q-cat { margin: 12rpx 0 0 56rpx; }
.ask-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 0 48rpx calc(24rpx + env(safe-area-inset-bottom)); background: linear-gradient(transparent, #f6f6f7 40%); }
.ask { margin-top: 24rpx; }
.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 60; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #f6f6f7; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-t { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.pick-img { flex: 1; font-size: 26rpx; color: #3a6fd8; }
