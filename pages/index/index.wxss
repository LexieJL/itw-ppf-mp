.banner { height: 320rpx; margin: 24rpx 32rpx 0; border-radius: 28rpx; overflow: hidden; box-shadow: 0 16rpx 40rpx rgba(90,0,30,.18); }
.slide { height: 100%; padding: 36rpx 40rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-end; color: #fff; position: relative; overflow: hidden; }
.deco1 { position: absolute; right: -60rpx; top: -80rpx; width: 320rpx; height: 320rpx; border-radius: 50%; border: 44rpx solid rgba(255,255,255,.08); box-sizing: border-box; }
.deco2 { position: absolute; right: 80rpx; bottom: -100rpx; width: 220rpx; height: 220rpx; border-radius: 50%; background: rgba(255,255,255,.07); }
.slide-tag { align-self: flex-start; font-size: 20rpx; background: rgba(255,255,255,.2); padding: 4rpx 16rpx; border-radius: 999rpx; margin-bottom: 16rpx; position: relative; }
.slide-title { font-size: 32rpx; font-weight: 600; line-height: 1.45; position: relative; }
.slide-sub { font-size: 22rpx; opacity: .8; margin-top: 16rpx; position: relative; }

.notice { margin: 24rpx 32rpx 0; padding: 22rpx 24rpx 22rpx 28rpx; background: linear-gradient(90deg, #fff7f9, #fdeef3); border: 2rpx solid #f3dce4; color: #6b1a36; border-radius: 24rpx; font-size: 24rpx; display: flex; align-items: center; justify-content: space-between; }
.notice-go { flex-shrink: 0; background: #8A1538; color: #fff; border-radius: 999rpx; padding: 8rpx 22rpx; font-size: 22rpx; }

.modules { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 28rpx 32rpx 240rpx; }
.module { width: calc(50% - 12rpx); background: #fff; border-radius: 28rpx; padding: 32rpx 28rpx 28rpx; box-sizing: border-box; margin-bottom: 24rpx; position: relative; overflow: hidden; border: 2rpx solid #f2eef0; box-shadow: 0 4rpx 20rpx rgba(60,10,30,.05); }
.m-deco { position: absolute; right: -52rpx; bottom: -52rpx; width: 144rpx; height: 144rpx; border-radius: 50%; opacity: .5; }
.m-icon { width: 84rpx; height: 84rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.m-icon image { width: 42rpx; height: 42rpx; }
.m-name { font-size: 30rpx; font-weight: 600; position: relative; }
.m-sub { font-size: 22rpx; color: #999; margin-top: 8rpx; position: relative; }
.m-badge { position: absolute; right: 20rpx; top: 24rpx; font-size: 20rpx; display: flex; align-items: center; padding: 4rpx 14rpx; border-radius: 999rpx; background: #f6f6f7; color: #888; }
.m-badge image { width: 20rpx; height: 20rpx; margin-right: 6rpx; }
.m-badge.ext { background: #e8f5e9; color: #2e7d32; }
.m-badge.new { background: #f6e8ed; color: #8A1538; }
