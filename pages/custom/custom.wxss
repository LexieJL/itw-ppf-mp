.b-title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; }
.b-body { font-size: 26rpx; color: #555; line-height: 1.8; }
.b-video { height: 360rpx; }
.entries { display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.entry { flex: 1; margin: 0 8rpx; background: #fff; border-radius: 16rpx; padding: 28rpx 0; text-align: center; font-size: 26rpx; color: #8B0033; font-weight: 600; }
.prod { background: #fff; border-radius: 16rpx; overflow: hidden; }
.prod-img { height: 180rpx; font-size: 22rpx; }
.prod-name { padding: 14rpx 16rpx 0; font-size: 24rpx; font-weight: 600; }
.prod-brand { padding: 4rpx 16rpx 16rpx; font-size: 20rpx; }
.pdf { display: flex; align-items: center; padding: 28rpx; }
.pdf-ico { font-size: 20rpx; color: #fff; background: #8B0033; border-radius: 8rpx; padding: 4rpx 12rpx; margin-right: 20rpx; }
.pdf-t { flex: 1; font-size: 28rpx; }
.pdf-go { font-size: 40rpx; color: #bbb; }
