.title { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.desc { font-size: 26rpx; color: #555; line-height: 1.7; }
.diagram { height: 300rpx; }
.articles { white-space: nowrap; }
.article { display: inline-block; width: 420rpx; margin-right: 20rpx; background: #fff; border-radius: 16rpx; overflow: hidden; vertical-align: top; }
.article-img { height: 200rpx; font-size: 22rpx; }
.article-title { padding: 16rpx; font-size: 24rpx; white-space: normal; line-height: 1.5; height: 72rpx; overflow: hidden; }
.video { height: 380rpx; }
.files { margin-top: 24rpx; }
.file { background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx; box-sizing: border-box; font-size: 28rpx; font-weight: 600; }
.file-ico { display: inline-block; font-size: 20rpx; color: #fff; background: #8A1538; border-radius: 8rpx; padding: 4rpx 12rpx; margin-bottom: 12rpx; }
.file .muted { font-weight: normal; margin-top: 6rpx; }


.media-video { display:block;width:100%;height:380rpx; }
.container { padding-bottom:200rpx; }

.app-cover{width:100%;display:block;height:320rpx;margin-bottom:0}.preview-gate{background:#fff;border-radius:24rpx;overflow:hidden;margin-top:12rpx}.teaser-copy{padding:32rpx 36rpx 0}.preview-fade{max-height:280rpx;position:relative;overflow:hidden;font-size:28rpx;color:#555;line-height:1.9;margin-top:16rpx}.context-copy{margin-top:20rpx}.preview-fade:after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,transparent 45%,rgba(255,255,255,.7) 80%,#fff);pointer-events:none}.gate-content{padding:8rpx 36rpx 28rpx;text-align:center}.gate-title{font-size:34rpx;font-weight:600;color:#222}.gate-text{font-size:24rpx;line-height:1.7;color:#888;margin:8rpx 0 20rpx}.gate-button{background:#8a1538;color:#fff;border-radius:999rpx;font-size:28rpx}.gate-back{font-size:24rpx;padding:20rpx 0 0;color:#777}
