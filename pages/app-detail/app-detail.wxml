<view class="breadcrumb">{{crumb}}</view>
<view class="container {{lock ? 'blurred' : ''}}">
  <view class="card card-pad">
    <view class="title">{{app.name}}</view>
    <view class="desc">{{app.desc}}</view>
  </view>
  <view class="card ph diagram">应用图示</view>

  <view wx:if="{{articles.length}}" class="section-title">相关推文</view>
  <scroll-view scroll-x class="articles" enhanced show-scrollbar="{{false}}">
    <view class="article" wx:for="{{articles}}" wx:key="title" bindtap="openArticle" data-url="{{item.url}}">
      <image wx:if="{{item.coverImageUrl}}" class="article-img" src="{{item.coverImageUrl}}" mode="aspectFill" /><view wx:else class="ph article-img">推文封面</view>
      <view class="article-title">{{item.title}}</view>
    </view>
  </scroll-view>

  <block wx:if="{{videos.length && !lock}}">
    <view class="section-title">应用视频</view>
    <view class="card" wx:for="{{videos}}" wx:key="id"><video class="media-video" src="{{item.src}}" poster="{{item.poster}}" controls binderror="onVideoError" /><view class="card-pad">{{item.title}}</view></view>
  </block>

  <view class="grid2 files" wx:if="{{documents.length}}"><view class="cell file" wx:for="{{documents}}" wx:key="id" bindtap="openDocument" data-url="{{item.url}}"><view class="file-ico">文档</view><view>{{item.title}}</view></view></view>
  <view class="grid2 files">
    <view wx:if="{{!documents.length && app.singlePageDocId}}" class="cell file" bindtap="openSinglePage">
      <view class="file-ico">PDF</view><view>单页</view>
      <view class="muted">跳转专属知识库</view>
    </view>
    <view wx:if="{{app.achDocId}}" class="cell file" bindtap="openAch">
      <view class="file-ico">ACH</view><view>销售用ACH源文件</view>
      <view class="muted">跳转专属知识库</view>
    </view>
  </view>
</view>
<action-bar wx:if="{{!lock}}" item="{{favItem}}" consult="{{consultUrl}}" />
<lock-mask lock="{{lock}}" />
<float-bar bottom="{{160}}" />

